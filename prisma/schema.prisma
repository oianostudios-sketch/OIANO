// OIANO StudioOS — Full Phase 1 Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ARTIST
  PRODUCER
  STUDIO_ADMIN
  ENGINEER
  OIANO_ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Facilities — how bad the reported symptom is, set by the reporter at
// report time (§15's "cannot use / degraded / minor").
enum IssueSeverity {
  CRITICAL // cannot use
  DEGRADED // usable with restrictions
  MINOR    // worth monitoring
}

// Facilities — the issue's own lifecycle IS its visual state (no separate
// "readiness" enum stored anywhere); Room/Equipment readiness is always
// derived live from whether an open (non-RESTORED) issue references them.
enum IssueStatus {
  REPORTED
  ASSIGNED
  REPAIRING
  VERIFY
  RESTORED
}

enum ProjectPhase {
  PRE_PRODUCTION
  TRACKING
  EDITING
  MIXING
  MASTERING
  DELIVERED
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ServiceCategory {
  RECORDING
  FULL_DAY
  MIX_MASTER
  COACHING
  EVENT
  MEMBERSHIP
}

enum CircleConsentStatus {
  ELIGIBLE
  REQUESTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum CircleVisibility {
  HIDDEN
  INITIALS
  STAGE_NAME
  FULL_PROFILE
}

enum CommunicationThreadKind {
  DIRECT
  BOOKING
  PROJECT
  STUDIO
  SUPPORT
}

enum CommunicationThreadState {
  OPEN
  WAITING_ON_USER
  RESOLVED
  EXPIRED
  ARCHIVED
}

enum CommunicationParticipantRole {
  OWNER
  MEMBER
  ASSIGNEE
  OBSERVER
  SUPPORT
}

enum CommunicationParticipantState {
  ACTIVE
  REMOVED
  EXPIRED
}

enum CommunicationEventKind {
  MESSAGE
  FILE
  ACTIVITY
  ACTION_REQUESTED
  DECISION_RECORDED
  STATE_CHANGED
  SYSTEM
}

// ─── Core Auth ────────────────────────────────────────────────────────────────

model User {
  id                          String            @id @default(uuid())
  email                       String            @unique
  password_hash               String?
  auth_version                Int               @default(0)
  role                        UserRole          @default(ARTIST)
  artist                      Artist?
  studio_staff                StudioStaff[]
  active_studio_id            String? // which StudioStaff membership resolveStaffStudio() scopes to; auto-set on first resolve, changed via PATCH /api/studio/active
  notifications               Notification[]
  booking_messages            BookingMessage[]
  project_messages            ProjectMessage[]
  producer                    Producer?
  engineer                    Engineer?
  locale                      String?           @default("en-US")
  mfa_secret_encrypted        String?
  mfa_enabled                 Boolean           @default(false)
  created_at                  DateTime          @default(now())
  updated_at                  DateTime          @updatedAt
  admin_audit_logs            AdminAuditLog[]
  policy_exceptions_requested PolicyException[] @relation("PolicyExceptionRequestedBy")
  policy_exceptions_approved  PolicyException[] @relation("PolicyExceptionApprovedBy")
  feedback                    Feedback[]
  communication_threads_created CommunicationThread[]      @relation("CommunicationThreadCreator")
  communication_threads_waiting CommunicationThread[]      @relation("CommunicationThreadWaitingOn")
  communication_participations  CommunicationParticipant[]
  communication_events          CommunicationEvent[]
  maintenance_issues_reported   MaintenanceIssue[]          @relation("MaintenanceIssueReporter")
  maintenance_issues_assigned   MaintenanceIssue[]          @relation("MaintenanceIssueAssignee")
  maintenance_issues_verified   MaintenanceIssue[]          @relation("MaintenanceIssueVerifier")

  @@map("users")
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actor_id    String
  actor       User     @relation(fields: [actor_id], references: [id])
  action      String
  target_type String?
  target_id   String?
  method      String?
  path        String?
  ip_hash     String?
  user_agent  String?
  metadata    Json     @default("{}")
  created_at  DateTime @default(now())

  @@index([actor_id, created_at])
  @@index([action, created_at])
  @@map("admin_audit_logs")
}

// ─── Studio ───────────────────────────────────────────────────────────────────

model Studio {
  id                   String               @id @default(uuid())
  slug                 String               @unique
  name                 String
  timezone             String               @default("America/New_York")
  currency             String               @default("USD")
  operating_open_hour  Int                  @default(8)
  operating_close_hour Int                  @default(22)
  stripe_account_id    String?
  platform_fee_bps     Int                  @default(0)
  address              String?
  phone                String?
  email                String?
  logo_url             String?
  hero_image_url       String?
  amenities            String[]             @default([])
  mint_letter          String               @default("Z") // passport code mint letter for this studio, e.g. OIA-Z0001
  passport_seq         Int                  @default(0) // atomically incremented on each passport mint
  rooms                Room[]
  engineers            Engineer[]
  services             ServiceOffering[]
  bookings             Booking[]
  availability         AvailabilitySlot[]
  staff                StudioStaff[]
  announcements        StudioAnnouncement[]
  circle_members       StudioCircleMember[]
  policies             StudioPolicy[]
  policy_exceptions    PolicyException[]
  staff_invitations    StudioStaffInvitation[]
  communication_threads CommunicationThread[]
  equipment            Equipment[]
  maintenance_issues   MaintenanceIssue[]
  created_at           DateTime             @default(now())

  @@map("studios")
}

model StudioStaff {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  studio_id    String
  studio       Studio   @relation(fields: [studio_id], references: [id])
  role         UserRole @default(STUDIO_ADMIN)
  position     String   @default("MANAGER")
  capabilities String[] @default([])
  created_at   DateTime @default(now())

  // A user may staff more than one studio — @@unique (not user_id alone)
  // is what allows that, while still preventing a duplicate membership row
  // for the same (user, studio) pair. See User.active_studio_id for which
  // one a request is currently scoped to.
  @@unique([user_id, studio_id])
  @@index([user_id])
  @@map("studio_staff")
}

model StudioStaffInvitation {
  id           String   @id @default(uuid())
  studio_id    String
  studio       Studio   @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  email        String
  role         UserRole @default(ENGINEER)
  position     String
  capabilities String[] @default([])
  token_hash   String   @unique
  status       String   @default("PENDING")
  invited_by   String
  expires_at   DateTime
  accepted_at  DateTime?
  created_at   DateTime @default(now())

  @@index([studio_id, status, created_at])
  @@index([email, status])
  @@map("studio_staff_invitations")
}

model Room {
  id           String             @id @default(uuid())
  studio_id    String
  studio       Studio             @relation(fields: [studio_id], references: [id])
  name         String
  capacity     Int?
  description  String?
  image_url    String?
  amenities    String[]           @default([])
  hourly_rate  Decimal?           @db.Decimal(10, 2)
  bookings     Booking[]
  availability AvailabilitySlot[]
  equipment    Equipment[]
  issues       MaintenanceIssue[]

  @@map("rooms")
}

// ─── Facilities (studio physical maintenance — distinct from the OIANO_ADMIN
// operations console at /maintenance) ──────────────────────────────────────

model Equipment {
  id              String             @id @default(uuid())
  studio_id       String
  studio          Studio             @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  room_id         String?
  room            Room?              @relation(fields: [room_id], references: [id])
  name            String
  type            String
  serial          String?
  added_at        DateTime           @default(now())
  last_service_at DateTime?
  next_service_at DateTime?
  notes           String?
  issues          MaintenanceIssue[]
  created_at      DateTime           @default(now())

  @@index([studio_id])
  @@index([room_id])
  @@map("equipment")
}

model MaintenanceIssue {
  id           String        @id @default(uuid())
  studio_id    String
  studio       Studio        @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  room_id      String?
  room         Room?         @relation(fields: [room_id], references: [id])
  equipment_id String?
  equipment    Equipment?    @relation(fields: [equipment_id], references: [id])
  booking_id   String?
  booking      Booking?      @relation(fields: [booking_id], references: [id])
  reported_by  String
  reporter     User          @relation("MaintenanceIssueReporter", fields: [reported_by], references: [id])
  symptom      String
  severity     IssueSeverity
  status       IssueStatus   @default(REPORTED)
  assigned_to  String?
  assignee     User?         @relation("MaintenanceIssueAssignee", fields: [assigned_to], references: [id])
  notes        String?
  resolved_at  DateTime?
  verified_by  String?
  verifier     User?         @relation("MaintenanceIssueVerifier", fields: [verified_by], references: [id])
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  @@index([studio_id, status])
  @@index([room_id, status])
  @@index([equipment_id, status])
  @@map("maintenance_issues")
}

model Engineer {
  id                 String             @id @default(uuid())
  studio_id          String
  studio             Studio             @relation(fields: [studio_id], references: [id])
  // Links this bookable-resource record to a real login (User role=ENGINEER).
  // Previously unset for every Engineer -- the logged-in "engineer" and the
  // Engineer assigned to a booking were two disconnected records with no way
  // to tell they're the same person. Nullable: a studio can have Engineers
  // (e.g. freelancers) with no login of their own.
  user_id            String?            @unique
  user               User?              @relation(fields: [user_id], references: [id])
  name               String
  specialties        String[]
  hourly_rate_usd    Decimal?           @db.Decimal(10, 2)
  bio                String?
  avatar_url         String?
  credits            String[]           @default([])
  bookings           Booking[]          @relation("AssignedEngineer")
  preferred_bookings Booking[]          @relation("PreferredEngineer")
  availability       AvailabilitySlot[]

  @@map("engineers")
}

model ServiceOffering {
  id            String          @id @default(uuid())
  studio_id     String
  studio        Studio          @relation(fields: [studio_id], references: [id])
  category      ServiceCategory
  name          String
  description   String?
  min_price_usd Decimal         @db.Decimal(10, 2)
  max_price_usd Decimal         @db.Decimal(10, 2)
  unit          String // "hour" | "session" | "track" | "month"
  bookings      Booking[]

  @@map("service_offerings")
}

model AvailabilitySlot {
  id          String    @id @default(uuid())
  studio_id   String
  studio      Studio    @relation(fields: [studio_id], references: [id])
  room_id     String?
  room        Room?     @relation(fields: [room_id], references: [id])
  engineer_id String?
  engineer    Engineer? @relation(fields: [engineer_id], references: [id])
  starts_at   DateTime
  ends_at     DateTime
  is_blocked  Boolean   @default(false)
  note        String?

  @@index([studio_id, room_id, starts_at, ends_at])
  @@map("availability_slots")
}

// ─── Artist ───────────────────────────────────────────────────────────────────

model Artist {
  id                   String               @id @default(uuid())
  user_id              String               @unique
  user                 User                 @relation(fields: [user_id], references: [id])
  name                 String
  alias                String?
  bio                  String?
  avatar_url           String?
  status               ArtistAvailability   @default(AVAILABLE_FOR_BOOKING)
  passport             ArtistPassport?
  wallet               Wallet?
  bookings             Booking[]
  session_logs         SessionLog[]
  files                ArtistFile[]
  projects             Project[]
  releases             ArtistRelease[]
  connections_sent     PassportConnection[] @relation("ConnectInitiator")
  connections_received PassportConnection[] @relation("ConnectRecipient")
  connect_messages     ConnectMessage[]     @relation("ConnectMessages")
  activity_events      ActivityEvent[]
  studio_circles       StudioCircleMember[]
  // Nullable, set once by POST /passport/onboarding/complete — never a
  // client-supplied timestamp. Null for every artist who signed up before
  // this field existed, which is honest: they never went through a flow
  // with a completion flag, so there's nothing to backfill.
  onboarding_completed_at DateTime?
  created_at           DateTime             @default(now())

  @@map("artists")
}

model StudioCircleMember {
  id                 String              @id @default(uuid())
  studio_id          String
  studio             Studio              @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  artist_id          String
  artist             Artist              @relation(fields: [artist_id], references: [id], onDelete: Cascade)
  consent_status     CircleConsentStatus @default(ELIGIBLE)
  visibility         CircleVisibility    @default(HIDDEN)
  show_session_count Boolean             @default(false)
  show_projects      Boolean             @default(false)
  session_count      Int                 @default(1)
  first_session_at   DateTime
  last_session_at    DateTime
  consented_at       DateTime?
  withdrawn_at       DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  @@unique([studio_id, artist_id])
  @@index([studio_id, consent_status, last_session_at])
  @@index([artist_id, consent_status])
  @@map("studio_circle_members")
}

model ArtistPassport {
  id                      String         @id @default(uuid())
  artist_id               String         @unique
  artist                  Artist         @relation(fields: [artist_id], references: [id])
  passport_code           String         @unique // e.g. OIANO-A1B2
  creative_dna            Json           @default("{}") // genres, influences, vocal, energy
  profile_strength        Int            @default(0) // 0–100
  profile_image_url       String? // avatar / press photo
  bio                     String? // short artist bio
  ai_summary              String? // cached AI brief
  ai_summary_updated_at   DateTime? // for cache invalidation
  ai_summary_edited       Boolean        @default(false) // true if artist manually edited
  ai_summary_public       Boolean        @default(true) // false = hidden from engineers
  profile_views           Int            @default(0) // incremented on non-owner views
  location                String?
  // PLACE GIVES CONTEXT, IT ISN'T IDENTITY BY DEFAULT — location has always
  // been silently public on the passport response below; this makes that a
  // real, explicit choice instead of an accident. Defaults false so a value
  // entered anywhere (onboarding included) is private until the artist
  // deliberately opts to publish it.
  location_public         Boolean        @default(false)
  social_links            Json           @default("{}")
  collaboration_interests String[]       @default([])
  issued_at               DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  views                   PassportView[]

  @@map("artist_passports")
}

model PassportView {
  id          String         @id @default(uuid())
  passport_id String
  passport    ArtistPassport @relation(fields: [passport_id], references: [id], onDelete: Cascade)
  viewer_hash String
  viewed_on   DateTime       @db.Date
  created_at  DateTime       @default(now())

  @@unique([passport_id, viewer_hash, viewed_on])
  @@index([passport_id, viewed_on])
  @@map("passport_views")
}

model ArtistRelease {
  id            String    @id @default(uuid())
  artist_id     String
  artist        Artist    @relation(fields: [artist_id], references: [id], onDelete: Cascade)
  title         String
  release_type  String
  release_date  DateTime?
  artwork_url   String?
  external_url  String?
  collaborators String[]  @default([])
  is_featured   Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([artist_id, release_date])
  @@map("artist_releases")
}

model Wallet {
  id           String              @id @default(uuid())
  artist_id    String              @unique
  artist       Artist              @relation(fields: [artist_id], references: [id])
  balance_usd  Decimal             @default(0) @db.Decimal(10, 2)
  transactions WalletTransaction[]
  top_ups      WalletTopUp[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  wallet_id   String
  wallet      Wallet   @relation(fields: [wallet_id], references: [id])
  amount_usd  Decimal  @db.Decimal(10, 2)
  type        String // "credit" | "debit"
  description String?
  created_at  DateTime @default(now())

  @@index([wallet_id])
  @@map("wallet_transactions")
}

model ArtistFile {
  id          String   @id @default(uuid())
  artist_id   String
  artist      Artist   @relation(fields: [artist_id], references: [id])
  name        String
  url         String
  mime_type   String?
  size_bytes  Int?
  folder      String? // relative folder path, e.g. "Projects/MyAlbum" or "Bounces"
  source      String? // "daw_watcher" | "manual"
  uploaded_at DateTime @default(now())

  @@map("artist_files")
}

// ─── Booking & Sessions ───────────────────────────────────────────────────────

model Booking {
  id                    String                     @id @default(uuid())
  studio_id             String
  studio                Studio                     @relation(fields: [studio_id], references: [id])
  artist_id             String
  artist                Artist                     @relation(fields: [artist_id], references: [id])
  room_id               String
  room                  Room                       @relation(fields: [room_id], references: [id])
  engineer_id           String?
  engineer              Engineer?                  @relation("AssignedEngineer", fields: [engineer_id], references: [id])
  preferred_engineer_id String?
  preferred_engineer    Engineer?                  @relation("PreferredEngineer", fields: [preferred_engineer_id], references: [id])
  service_id            String
  service               ServiceOffering            @relation(fields: [service_id], references: [id])
  starts_at             DateTime
  ends_at               DateTime
  status                BookingStatus              @default(PENDING)
  total_usd             Decimal                    @db.Decimal(10, 2)
  notes                 String?
  payment               Payment?
  session_log           SessionLog?
  messages              BookingMessage[]
  communication_thread  CommunicationThread?
  project_id            String?
  project               Project?                   @relation(fields: [project_id], references: [id])
  deliverables          Deliverable[]
  completion_requests   SessionCompletionRequest[]
  maintenance_issues    MaintenanceIssue[]
  weave_evidence        WeaveEvidence[]
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt

  // SCALE_READINESS_ROADMAP.md Tier 0.2 — Booking had zero indexes despite
  // being the highest-traffic model; these three cover the hot paths: booking
  // lists/Pulse aggregates by studio+date, an artist's own booking list, and
  // the room/time overlap conflict check that runs on every create/reschedule.
  @@index([studio_id, starts_at])
  @@index([artist_id, starts_at])
  @@index([room_id, starts_at, ends_at])
  @@map("bookings")
}

// Studio operating standards are data, not hard-coded controller branches.
// `conditions` and `default_outcome` use versioned JSON contracts interpreted
// by the policy engine; domain/subject remain strings so studios can add new
// service and workflow policy families without a database enum migration.
model StudioPolicy {
  id                  String            @id @default(uuid())
  studio_id           String
  studio              Studio            @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  domain              String
  subject             String
  name                String
  description         String?
  conditions          Json              @default("{}")
  default_outcome     Json
  enforcement         String            @default("CONTROLLED")
  override_capability String?
  priority            Int               @default(100)
  version             Int               @default(1)
  status              String            @default("ACTIVE")
  effective_from      DateTime          @default(now())
  effective_until     DateTime?
  created_by          String
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  exceptions          PolicyException[]

  @@unique([studio_id, domain, subject, version])
  @@index([studio_id, status, effective_from])
  @@map("studio_policies")
}

model PolicyException {
  id               String       @id @default(uuid())
  studio_id        String
  studio           Studio       @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  policy_id        String
  policy           StudioPolicy @relation(fields: [policy_id], references: [id], onDelete: Restrict)
  target_type      String
  target_id        String
  normal_values    Json
  requested_values Json
  consequence      Json         @default("{}")
  reason           String
  status           String       @default("REQUESTED")
  requested_by     String
  requester        User         @relation("PolicyExceptionRequestedBy", fields: [requested_by], references: [id], onDelete: Restrict)
  approved_by      String?
  approver         User?        @relation("PolicyExceptionApprovedBy", fields: [approved_by], references: [id], onDelete: Restrict)
  approval_note    String?
  expires_at       DateTime?
  approved_at      DateTime?
  applied_at       DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  @@index([studio_id, status, created_at])
  @@index([target_type, target_id])
  @@index([policy_id, created_at])
  @@map("policy_exceptions")
}

model SessionCompletionRequest {
  id              String   @id @default(uuid())
  booking_id      String
  booking         Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  idempotency_key String
  response        Json
  created_at      DateTime @default(now())

  @@unique([booking_id, idempotency_key])
  @@index([booking_id, created_at])
  @@map("session_completion_requests")
}

model Deliverable {
  id              String               @id @default(uuid())
  booking_id      String
  booking         Booking              @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  title           String
  status          String               @default("PENDING_REVIEW")
  visibility      String               @default("STUDIO_ONLY") // "PRIVATE" | "STUDIO_ONLY" | "PASSPORT_PUBLIC" — PASSPORT_PUBLIC may only be set by the owning artist, never by studio staff
  current_version Int                  @default(1)
  created_by      String
  reviewed_at     DateTime?
  review_due_at   DateTime?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  versions        DeliverableVersion[]
  reviews         DeliverableReview[]

  @@index([booking_id, status])
  @@map("deliverables")
}

model DeliverableVersion {
  id             String      @id @default(uuid())
  deliverable_id String
  deliverable    Deliverable @relation(fields: [deliverable_id], references: [id], onDelete: Cascade)
  version_number Int
  file_urls      String[]
  notes          String?
  created_by     String
  created_at     DateTime    @default(now())

  @@unique([deliverable_id, version_number])
  @@map("deliverable_versions")
}

model DeliverableReview {
  id             String      @id @default(uuid())
  deliverable_id String
  deliverable    Deliverable @relation(fields: [deliverable_id], references: [id], onDelete: Cascade)
  version_number Int
  decision       String
  note           String?
  reviewed_by    String
  created_at     DateTime    @default(now())

  @@index([deliverable_id, created_at])
  @@map("deliverable_reviews")
}

model Payment {
  id                String        @id @default(uuid())
  booking_id        String        @unique
  booking           Booking       @relation(fields: [booking_id], references: [id])
  provider          String // "stripe" | "wallet" | "cash"
  provider_ref      String?       @unique // Stripe checkout session ID
  payment_intent_id String? // Stripe payment_intent ID — used for refund/failure matching
  amount_usd        Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(UNPAID)
  paid_at           DateTime?
  refunded_usd      Decimal       @default(0) @db.Decimal(10, 2)
  refund_ref        String?
  created_at        DateTime      @default(now())

  @@map("payments")
}

// Wallet top-ups via Stripe — separate from booking payments
model WalletTopUp {
  id                String   @id @default(uuid())
  wallet_id         String
  wallet            Wallet   @relation(fields: [wallet_id], references: [id])
  provider_ref      String?  @unique // Stripe checkout session ID
  payment_intent_id String?
  amount_usd        Decimal  @db.Decimal(10, 2)
  status            String   @default("PENDING") // PENDING | PAID | FAILED
  created_at        DateTime @default(now())

  @@map("wallet_topups")
}

// Stripe retries webhook delivery. Recording event IDs provides an audit trail
// and prevents an already-completed event from being applied twice.
model StripeWebhookEvent {
  id           String    @id
  type         String
  status       String    @default("PROCESSING")
  processed_at DateTime?
  created_at   DateTime  @default(now())

  @@map("stripe_webhook_events")
}

model SessionLog {
  id                 String    @id @default(uuid())
  booking_id         String    @unique
  booking            Booking   @relation(fields: [booking_id], references: [id])
  artist_id          String
  artist             Artist    @relation(fields: [artist_id], references: [id])
  notes              String?
  quality_rating     Int? // 1–5 engineer rates session
  artist_rating      Int? // 1–5 artist rates engineer
  artist_testimonial String? // shown on engineer profile only if testimonial_public is true
  testimonial_public Boolean   @default(false) // set only by the artist, never by studio staff
  ai_summary         String?
  tracks_worked      String[]
  started_at         DateTime?
  ended_at           DateTime?

  @@map("session_logs")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  type       String // "booking_confirmed" | "session_reminder" | "payment_received" etc.
  title      String
  body       String
  payload    Json      @default("{}")
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, created_at])
  @@map("notifications")
}

// ─── Booking Messages ─────────────────────────────────────────────────────────

model BookingMessage {
  id         String   @id @default(uuid())
  booking_id String
  booking    Booking  @relation(fields: [booking_id], references: [id])
  sender_id  String
  sender     User     @relation(fields: [sender_id], references: [id])
  body       String
  created_at DateTime @default(now())

  @@index([booking_id, created_at])
  @@map("booking_messages")
}

// ─── Producer ─────────────────────────────────────────────────────────────────

model Producer {
  id              String            @id @default(uuid())
  user_id         String            @unique
  user            User              @relation(fields: [user_id], references: [id])
  name            String
  alias           String?
  bio             String?
  avatar_url      String?
  passport        ProducerPassport?
  projects        Project[]
  tracks          Track[]
  open_to_collabs Boolean           @default(true)
  primary_discipline String         @default("PRODUCER")
  disciplines       Json           @default("[\"PRODUCER\"]")
  services           Json           @default("[]")
  location           String?
  onboarding_complete Boolean       @default(false)
  created_at      DateTime          @default(now())

  @@index([primary_discipline])
  @@map("producers")
}

model ProducerPassport {
  id               String   @id @default(uuid())
  producer_id      String   @unique
  producer         Producer @relation(fields: [producer_id], references: [id])
  passport_code    String   @unique // e.g. PROD-X1Y2
  genres_produced  Json     @default("[]") // string[]
  signature_tags   Json     @default("[]") // string[] e.g. "trap hi-hats"
  profile_strength Int      @default(0)
  profile_views    Int      @default(0)
  issued_at        DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("producer_passports")
}

// ─── Beat/Sample Catalogue ──────────────────────────────────────────────────────
// Pass 1: preview-only catalogue. price_usd/license_type sit unused until
// checkout + file-protection are built.
model Track {
  id           String   @id @default(uuid())
  producer_id  String
  producer     Producer @relation(fields: [producer_id], references: [id])
  title        String
  file_url     String
  waveform_url String?
  duration_sec Int?
  bpm          Int?
  genre        String?
  tags         Json     @default("[]") // string[]
  price_usd    Int?
  license_type String?
  play_count   Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  @@map("tracks")
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id                   String               @id @default(uuid())
  producer_id          String
  producer             Producer             @relation(fields: [producer_id], references: [id])
  artist_id            String?
  artist               Artist?              @relation(fields: [artist_id], references: [id])
  title                String
  phase                ProjectPhase         @default(PRE_PRODUCTION)
  notes                String?
  is_active            Boolean              @default(true)
  is_public            Boolean              @default(false)
  last_session_at      DateTime?
  bookings             Booking[]
  participants         ProjectParticipant[]
  credits              ProjectCredit[]
  promotional_consents PromotionalConsent[]
  rights_agreements    RightsAgreement[]
  messages             ProjectMessage[]
  communication_thread CommunicationThread?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  @@map("projects")
}

model ProjectMessage {
  id         String   @id @default(uuid())
  project_id String
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sender_id  String
  sender     User     @relation(fields: [sender_id], references: [id])
  body       String
  kind       String   @default("MESSAGE")
  created_at DateTime @default(now())

  @@index([project_id, created_at])
  @@map("project_messages")
}

model RightsAgreement {
  id             String           @id @default(uuid())
  project_id     String
  project        Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  agreement_type String
  title          String
  terms_note     String?
  status         String           @default("PROPOSED")
  created_by     String
  responded_by   String?
  response_note  String?
  responded_at   DateTime?
  effective_at   DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  shares         RightsShare[]
  decisions      RightsDecision[]

  @@index([project_id, agreement_type, status])
  @@map("rights_agreements")
}

model FinancialTransaction {
  id          String                 @id @default(uuid())
  source_type String
  source_id   String
  currency    String                 @default("USD")
  status      String                 @default("POSTED")
  description String?
  metadata    Json                   @default("{}")
  occurred_at DateTime               @default(now())
  created_at  DateTime               @default(now())
  entries     FinancialLedgerEntry[]

  @@unique([source_type, source_id])
  @@index([occurred_at])
  @@map("financial_transactions")
}

model FinancialLedgerEntry {
  id             String               @id @default(uuid())
  transaction_id String
  transaction    FinancialTransaction @relation(fields: [transaction_id], references: [id], onDelete: Restrict)
  account_code   String
  direction      String
  amount_usd     Decimal              @db.Decimal(12, 2)
  owner_type     String?
  owner_id       String?
  created_at     DateTime             @default(now())

  @@index([account_code, created_at])
  @@index([owner_type, owner_id, created_at])
  @@map("financial_ledger_entries")
}

model RightsDecision {
  id             String          @id @default(uuid())
  agreement_id   String
  agreement      RightsAgreement @relation(fields: [agreement_id], references: [id], onDelete: Cascade)
  holder_user_id String
  holder_name    String
  status         String          @default("PENDING")
  note           String?
  evidence       Json?
  responded_at   DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  @@unique([agreement_id, holder_user_id])
  @@index([holder_user_id, status])
  @@map("rights_decisions")
}

model RightsShare {
  id            String          @id @default(uuid())
  agreement_id  String
  agreement     RightsAgreement @relation(fields: [agreement_id], references: [id], onDelete: Cascade)
  holder_name   String
  holder_type   String
  holder_ref_id String?
  role          String
  percentage    Decimal         @db.Decimal(5, 2)
  created_at    DateTime        @default(now())

  @@index([agreement_id])
  @@map("rights_shares")
}

model PromotionalConsent {
  id           String    @id @default(uuid())
  project_id   String
  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  subject      String
  purpose      String
  channels     String[]
  assets       String[]
  expires_at   DateTime?
  status       String    @default("REQUESTED")
  requested_by String
  responded_by String?
  responded_at DateTime?
  withdrawn_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([project_id, status])
  @@map("promotional_consents")
}

model ProjectCredit {
  id             String   @id @default(uuid())
  project_id     String
  project        Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  credited_name  String
  role           String
  scope          String?
  participant_id String?
  status         String   @default("DRAFT")
  is_public      Boolean  @default(false) // may only flip true alongside the credited party's own CONFIRMED action, never set by studio staff
  added_by       String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([project_id, status])
  @@map("project_credits")
}

model ProjectParticipant {
  id                 String   @id @default(uuid())
  project_id         String
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  display_name       String
  email              String?
  role               String
  participant_type   String   @default("EXTERNAL")
  participant_ref_id String?
  status             String   @default("ACTIVE")
  added_by           String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([project_id])
  @@index([participant_ref_id])
  @@map("project_participants")
}

// ─── Studio Announcements ─────────────────────────────────────────────────────
model StudioAnnouncement {
  id         String   @id @default(uuid())
  studio_id  String
  studio     Studio   @relation(fields: [studio_id], references: [id])
  title      String
  body       String
  created_by String // user_id of the admin who posted
  created_at DateTime @default(now())

  @@map("studio_announcements")
}

// ─── Passport Connect (artist-to-artist DMs) ─────────────────────────────────
model PassportConnection {
  id           String           @id @default(uuid())
  initiator_id String // artist.id
  recipient_id String // artist.id
  status       ConnectStatus    @default(PENDING)
  created_at   DateTime         @default(now())
  messages     ConnectMessage[]
  communication_thread CommunicationThread?

  initiator Artist @relation("ConnectInitiator", fields: [initiator_id], references: [id])
  recipient Artist @relation("ConnectRecipient", fields: [recipient_id], references: [id])

  @@unique([initiator_id, recipient_id])
  @@map("passport_connections")
}

model ConnectMessage {
  id            String   @id @default(uuid())
  connection_id String
  sender_id     String // artist.id
  body          String
  created_at    DateTime @default(now())

  connection PassportConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  sender     Artist             @relation("ConnectMessages", fields: [sender_id], references: [id])

  @@map("connect_messages")
}

enum ConnectStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Canonical Communications ───────────────────────────────────────────────
// Relationship-scoped coordination. Existing message tables remain available
// during the migration window; their records are backfilled into events.
model CommunicationThread {
  id                 String                   @id @default(uuid())
  kind               CommunicationThreadKind
  state              CommunicationThreadState @default(OPEN)
  subject            String
  booking_id         String?                  @unique
  booking            Booking?                 @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  project_id         String?                  @unique
  project            Project?                 @relation(fields: [project_id], references: [id], onDelete: Cascade)
  connection_id      String?                  @unique
  connection         PassportConnection?      @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  studio_id          String?
  studio             Studio?                  @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  created_by         String
  creator            User                     @relation("CommunicationThreadCreator", fields: [created_by], references: [id])
  waiting_on_user_id String?
  waiting_on_user    User?                    @relation("CommunicationThreadWaitingOn", fields: [waiting_on_user_id], references: [id])
  expires_at         DateTime?
  resolved_at        DateTime?
  archived_at        DateTime?
  last_event_at      DateTime                 @default(now())
  created_at         DateTime                 @default(now())
  updated_at         DateTime                 @updatedAt
  participants       CommunicationParticipant[]
  events             CommunicationEvent[]

  @@index([state, last_event_at])
  @@index([studio_id, state, last_event_at])
  @@index([waiting_on_user_id, state])
  @@map("communication_threads")
}

model CommunicationParticipant {
  id         String                        @id @default(uuid())
  thread_id  String
  thread     CommunicationThread           @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User                          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       CommunicationParticipantRole  @default(MEMBER)
  state      CommunicationParticipantState @default(ACTIVE)
  joined_at  DateTime                      @default(now())
  removed_at DateTime?
  read_at    DateTime?

  @@unique([thread_id, user_id])
  @@index([user_id, state, thread_id])
  @@map("communication_participants")
}

model CommunicationEvent {
  id              String                 @id @default(uuid())
  thread_id       String
  thread          CommunicationThread    @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  sender_id       String?
  sender          User?                  @relation(fields: [sender_id], references: [id], onDelete: SetNull)
  kind            CommunicationEventKind @default(MESSAGE)
  body            String?
  payload         Json                   @default("{}")
  idempotency_key String?                @unique
  created_at      DateTime               @default(now())

  @@index([thread_id, created_at])
  @@map("communication_events")
}

// ─── Activity Events ──────────────────────────────────────────────────────────

enum ArtistAvailability {
  AVAILABLE_FOR_BOOKING
  IN_SESSION
  UNAVAILABLE
}

model ActivityEvent {
  id         String   @id @default(uuid())
  type       String // "profile.created" | "status.changed" | "session.booked" | "session.completed"
  artist_id  String?
  artist     Artist?  @relation(fields: [artist_id], references: [id])
  payload    Json     @default("{}")
  created_at DateTime @default(now())

  @@index([type])
  @@index([artist_id])
  @@map("activity_events")
}

enum FeedbackCategory {
  BUG
  CONFUSING
  FEATURE_REQUEST
  MISSING_INFO
  OTHER
}

enum FeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model Feedback {
  id          String           @id @default(uuid())
  user_id     String
  user        User             @relation(fields: [user_id], references: [id])
  category    FeedbackCategory
  page        String // route/path the tester was on when reporting
  description String
  status      FeedbackStatus   @default(OPEN)
  created_at  DateTime         @default(now())

  @@index([status, created_at])
  @@map("feedback")
}

// ─── Oiano Weave — network model foundation ─────────────────────────────────
// Deliberately prefixed WeaveNode/WeaveConnection, not Node/Connection:
// PassportConnection (below) already uses "Connection" for an unrelated
// artist-to-artist DM/request feature (initiator/recipient, PENDING/
// ACCEPTED/DECLINED) — weak, self-declared evidence, exactly what this layer
// is NOT. Keeping the names visually distinct in the schema and generated
// client matters more here than matching the brief's prose exactly.
//
// A WeaveNode is a growing creative entity (Artist or Studio for V1),
// independent of any single relationship. Not a copy of Artist/Studio data:
// WeaveNode.id is deliberately the SAME id as the underlying Artist.id /
// Studio.id (both uuid, globally unique across tables), so this stays a thin
// type-tagged registry rather than a second identity record — and it means
// a future User with both an Artist row and a Producer row naturally gets
// two independent WeaveNodes, never one Node standing in for a whole User.
// No back-relation is added on Artist/Studio themselves — a WeaveNode's
// existence is resolved by id lookup, not a Prisma relation, so this
// migration never touches either model.
enum WeaveNodeType {
  ARTIST
  STUDIO
}

enum WeaveNodeStatus {
  ACTIVE
  INACTIVE
}

model WeaveNode {
  id         String          @id
  type       WeaveNodeType
  status     WeaveNodeStatus @default(ACTIVE)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  connections_from WeaveConnection[] @relation("SourceNode")
  connections_to   WeaveConnection[] @relation("TargetNode")

  @@index([type])
  @@map("weave_nodes")
}

// A meaningful, evidence-backed relationship between two WeaveNodes. Never
// authoritative by itself — every WeaveConnection must carry at least one
// WeaveEvidence row citing the real domain record that proves it. V1 has
// exactly one type, derived only from completed Bookings; RECORDED_AT is
// stored directionally (source=Artist, target=Studio) so a lookup from
// either side is one indexed query with no duplicate reverse row to keep in
// sync.
enum WeaveConnectionType {
  RECORDED_AT
}

model WeaveConnection {
  id                String              @id @default(uuid())
  source_node_id    String
  source_node       WeaveNode           @relation("SourceNode", fields: [source_node_id], references: [id])
  target_node_id    String
  target_node       WeaveNode           @relation("TargetNode", fields: [target_node_id], references: [id])
  type              WeaveConnectionType
  // Explainable growth signal, not an opaque score — "worked together N
  // times," incremented only when new evidence is actually added.
  // Starts at 0, not 1: syncConnectionFromBooking always increments after
  // creating a connection's first evidence row too, so a @default(1) here
  // would silently double-count the first piece of evidence on every new
  // connection (found via the backfill script's first real run).
  activity_count    Int                 @default(0)
  first_activity_at DateTime
  last_activity_at  DateTime
  evidence          WeaveEvidence[]
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  @@unique([source_node_id, target_node_id, type])
  @@index([target_node_id, type])
  @@map("weave_connections")
}

// One row per real record a WeaveConnection is built from — kept separate
// from the connection itself so evidence can be added over time and a
// connection left with no evidence is a detectable, explainable state
// rather than a silent orphan. booking_id only for V1, following the same
// "add a nullable typed column, don't invent a polymorphic ref" convention
// ProjectParticipant/RightsShare already use elsewhere in this schema — the
// next evidence type (e.g. an APPROVED RightsShare, once a Producer
// WeaveNode exists) adds a column here, not a new table.
model WeaveEvidence {
  id            String          @id @default(uuid())
  connection_id String
  connection    WeaveConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  booking_id    String
  booking       Booking         @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  created_at    DateTime        @default(now())

  @@unique([connection_id, booking_id])
  @@index([booking_id])
  @@map("weave_connection_evidence")
}
