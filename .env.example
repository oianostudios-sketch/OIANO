# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oiano_studioos"

# Auth
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# App
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Anthropic (AI Brief feature)
ANTHROPIC_API_KEY="sk-ant-..."

# Stripe (Phase 3 — leave blank to use stub)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# OIANO Payments universal gateway layer. "mock" is safe for local development.
PAYMENTS_PROVIDER="mock"
PAYMENTS_WEBHOOK_SECRET=""
PAYMENTS_API_KEY=""
PAYMENTS_PLATFORM_FEE_BPS="1500"

# Greep Pay (feature-flagged — Phase 3+)
GREEP_API_KEY=""

# Seed credentials — used only by prisma/seed.ts, never at runtime
# Set these to strong passwords before running npm run db:seed in any environment
SEED_ADMIN_PASSWORD=""
SEED_ARTIST_PASSWORD=""
SEED_ENGINEER_PASSWORD=""
SEED_OIANO_ADMIN_PASSWORD=""

# SendGrid — email notifications
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="hello@dreamzmusiclab.com"
