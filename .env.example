# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oiano_studioos"

# Auth
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# MFA (OIANO_ADMIN only) secret-at-rest encryption key. Deliberately a
# separate secret from JWT_SECRET — previously the MFA encryption key was
# derived from JWT_SECRET, so one leaked secret compromised both live auth
# tokens and every stored MFA secret at once. Required unconditionally, same
# as JWT_SECRET. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY="change-me-to-a-different-long-random-string-in-production"

# App
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Sentry — error tracking. Fully optional; leave blank to skip entirely, no
# code changes needed. When set, every unhandled/5xx error is reported.
SENTRY_DSN=""

# Anthropic (AI Brief feature, and the intelligence layer below — same key)
ANTHROPIC_API_KEY="sk-ant-..."

# Intelligence layer (Next Action, Session Summary, Navigation Intelligence).
# Master flag gates all capability flags — off (or unset) restores normal
# Oiano behavior with no code changes. Each capability is independently
# switchable once the master flag is on.
OIANO_AI_ENABLED="false"
OIANO_AI_NEXT_ACTION="false"
OIANO_AI_SESSION_SUMMARY="false"
OIANO_AI_NAVIGATION="false"

# Stripe (Phase 3 — leave blank to use stub)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Greep Pay (feature-flagged — Phase 3+)
GREEP_API_KEY=""

# Seed credentials — used only by prisma/seed.ts, never at runtime
# Set these to strong passwords before running npm run db:seed in any environment
SEED_ADMIN_PASSWORD=""
SEED_ARTIST_PASSWORD=""
SEED_ENGINEER_PASSWORD=""
SEED_PRODUCER_PASSWORD=""
SEED_OIANO_ADMIN_PASSWORD=""

# SendGrid — email notifications
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="hello@dreamzmusiclab.com"

# Production operations — required by `npm run operations:verify` before launch
SUPPORT_EMAIL="support@oiano.net"
PRIVACY_EMAIL="privacy@oiano.net"
SECURITY_EMAIL="security@oiano.net"
OPERATIONS_ON_CALL=""
BACKUP_OUTPUT_DIR=""
BACKUP_RETENTION_DAYS="35"
BACKUP_RESTORE_TESTED_AT=""
LEGAL_ENTITY_NAME=""
LEGAL_ENTITY_ADDRESS=""
GOVERNING_LAW=""
