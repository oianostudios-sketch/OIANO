node_modules
# Keep environment variables out of version control
.env

# Local AI-assistant state can contain command history, bearer tokens, and
# machine-specific permissions. Never commit it.
.claude/settings.local.json

# Temporary Claude scratch exports occasionally arrive with a flattened
# Windows path as the filename at repository root.
/*scratchpad*.txt

/generated/prisma

# Local-disk fallback for avatar/track uploads when R2 isn't configured —
# real user content, not something to commit
apps/api/uploads/
apps/api/private-uploads/

# Build artifacts and runtime logs
apps/api/tsconfig.tsbuildinfo
apps/api/dist/
apps/web/dist/
packages/shared/src/*.js
packages/shared/src/*.d.ts
packages/shared/src/*.js.map
packages/shared/src/*.d.ts.map
packages/shared/tsconfig.tsbuildinfo
packages/shared/dist/
*.log
*.pid

# One-off root-level DB scripts — read DATABASE_URL from env, but keep them
# out of git entirely as defense in depth (see the July 2026 credential audit)
/run-migration-pg.js
/update-passwords.js

# Local agent tool config (not product code)
.codex/

# CI diagnostic capture (see .github/workflows/ci.yml)
test-output.txt
